<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form-validation PUBLIC
          "-//Apache Software Foundation//DTD Commons Validator Rules Configuration Bean 1.4.0//EN"
          "http://commons.apache.org/dtds/validator_1_4_0.dtd">

<form-validation>

    <formset>

        <form name="fixtureBean">

            <field property="firstName" depends="required">
                <arg key="prompt.firstName" position="0"/>
            </field>

            <field property="zip" depends="intRange">
                <arg key="prompt.zip" position="0"/>
                <var>
                    <var-name>min</var-name>
                    <var-value>10000</var-value>
                </var>
                <var>
                    <var-name>max</var-name>
                    <var-value>99999</var-value>
                </var>
            </field>

        </form>

        <form name="dynaTestBean">

            <field property="firstName" depends="required">
                <arg key="prompt.firstName" position="0"/>
            </field>

        </form>

    </formset>

</form-validation>
