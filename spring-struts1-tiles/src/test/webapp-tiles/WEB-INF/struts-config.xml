<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
          "-//Apache Software Foundation//DTD Struts Configuration 1.4//EN"
          "http://struts.apache.org/dtds/struts-config_1_4.dtd">

<struts-config>

    <action-mappings>
        <action path="/Page" type="org.apache.struts.tiles.it.DefinitionForwardAction">
            <forward name="page" path=".page"/>
        </action>

        <action path="/ControlledPage" type="org.apache.struts.tiles.it.DefinitionForwardAction">
            <forward name="page" path=".controlled"/>
        </action>

        <action path="/MenuPage" type="org.apache.struts.tiles.it.DefinitionForwardAction">
            <forward name="page" path=".menu"/>
        </action>

        <action path="/LocalePage" type="org.apache.struts.tiles.it.DefinitionForwardAction">
            <forward name="page" path=".locale"/>
        </action>

        <action path="/TilesRender" type="org.apache.struts.tiles.it.TestTilesAction"/>

        <action path="/ActionTilePage" type="org.apache.struts.tiles.it.DefinitionForwardAction">
            <forward name="page" path=".action-tile"/>
        </action>
    </action-mappings>

    <plug-in className="org.apache.struts.tiles.TilesPlugin">
        <set-property property="definitions-config" value="/WEB-INF/tiles-defs.xml"/>
        <set-property property="moduleAware" value="true"/>
    </plug-in>

</struts-config>
