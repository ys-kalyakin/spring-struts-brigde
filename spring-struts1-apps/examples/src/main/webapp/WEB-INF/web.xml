<?xml version="1.0" encoding="UTF-8"?>
<!--
    Struts Examples Application ported to the spring-struts1 engine.
    The engine is bootstrapped by the spring-struts1 starter through the
    Spring Boot application class; the module configurations live in
    WEB-INF/classes/application.properties (spring.struts1.config.*).
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
      version="6.1">

    <display-name>Struts Examples Application</display-name>

    <!-- The Usual Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
